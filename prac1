import collections

def bfs(graph, root):
    seen = set([root])
    queue = collections.deque([root])

    while queue:
        vertex = queue.popleft()
        print(vertex)

        for node in graph[vertex]:
            if node not in seen:
                seen.add(node)
                queue.append(node)


