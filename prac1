3)All paths from M to P:

def all_paths(graph, start, end):
    stack = [(start, [start])]

    while stack:
        vertex, path = stack.pop()

        for neighbour in graph.get(vertex, []):
            if neighbour in path:
                continue

            new_path = path + [neighbour]

            if neighbour == end:
                yield new_path
            else:
                stack.append((neighbour, new_path))


graph = {
    'M': ['R', 'Q', 'N'],
