    'O': ['N', 'P'],
    'R': ['M'],
    'Q': ['M', 'N', 'P'],
    'P': ['O', 'Q']
}


print("All paths from M to P:")

for path in all_paths(graph, 'M', 'P'):
    print(" -> ".join(path))

